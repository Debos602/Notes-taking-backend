{
  "info": {
    "_postman_id": "8c1bda47-a3c5-4423-a7d3-18b87938f945",
    "name": "Notes Takings APIs",
    "description": "Postman collection for the PH Tour Management API. Run Register or Login first to populate accessToken and refreshToken collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://backend-ph-tour-management-system.vercel.app" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Admin@1234" },
    { "key": "userId", "value": "replace-with-user-id" },
    { "key": "noteId", "value": "replace-with-note-id" }
  ],
  "item": [
    {
      "name": "Root",
      "item": [
        { "name": "API Welcome", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "if (json.data) {",
            "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
            "  if (json.data.user?._id) pm.collectionVariables.set('userId', json.data.user._id);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Tour User\",\n  \"email\": \"tour.user@example.com\",\n  \"password\": \"Tour@1234\",\n  \"interests\": [\"hiking\", \"beaches\"]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "if (json.data) {",
            "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
            "  if (json.data.user?._id) pm.collectionVariables.set('userId', json.data.user._id);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"tour.user@example.com\",\n  \"password\": \"Tour@1234\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Admin Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "if (json.data) {",
            "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
            "  if (json.data.user?._id) pm.collectionVariables.set('userId', json.data.user._id);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh Access Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "if (json.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Create User",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "if (json.data?._id) pm.collectionVariables.set('userId', json.data._id);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Managed User\",\n  \"email\": \"managed.user@example.com\",\n  \"password\": \"Managed@123\",\n  \"role\": \"USER\",\n  \"interests\": [\"nature\"]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/users" }
        },
        {
          "name": "Get All Users",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/users?searchTerm=tour&page=1&limit=10&sort=-createdAt", "query": [
            { "key": "searchTerm", "value": "tour" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "sort", "value": "-createdAt" }
          ] } }
        },
        { "name": "Get My Profile", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/users/me" } },
        { "name": "Get User By ID", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/users/{{userId}}" } },
        {
          "name": "Update User",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated User\",\n  \"interests\": [\"hiking\", \"culture\"]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/users/{{userId}}" }
        },
        { "name": "Delete User", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/users/{{userId}}" } }
      ]
    },
    {
      "name": "Notes",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Create Note",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "if (json.data?._id) pm.collectionVariables.set('noteId', json.data._id);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Packing list\",\n  \"content\": \"Passport, sunscreen, and hiking shoes.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/notes" }
        },
        {
          "name": "Get All Notes",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/notes?page=1&limit=10&sort=-createdAt", "query": [
            { "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "sort", "value": "-createdAt" }
          ] } }
        },
        { "name": "Get Note By ID", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/notes/{{noteId}}" } },
        {
          "name": "Update Note",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"content\": \"Updated trip preparation notes.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/notes/{{noteId}}" }
        },
        { "name": "Delete Note", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/notes/{{noteId}}" } }
      ]
    },
    {
      "name": "Posts",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Create Post",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"A weekend in Bandarban\",\n  \"content\": \"A short guide to trails, viewpoints, and local food.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/posts" }
        },
        {
          "name": "Get All Posts",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/posts?page=1&limit=10&sort=-createdAt", "query": [
            { "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "sort", "value": "-createdAt" }
          ] } }
        }
      ]
    },
    {
      "name": "Aggregations (Admin)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        { "name": "Group Users By Interest", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/aggregations/users/grouped-by-interest" } },
        { "name": "Get User Posts", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/aggregations/posts/user/{{userId}}" } }
      ]
    }
  ]
}
