    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "}",
                  "if (jsonData && jsonData.data && jsonData.data.refreshToken) {",
                  "  pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}",
                  "if (jsonData && jsonData.data && jsonData.data.user && jsonData.data.user._id) {",
                  "  pm.collectionVariables.set('userId', jsonData.data.user._id);",
                  "}",
                  "if (jsonData && jsonData.data && jsonData.data.user && jsonData.data.user.email) {",
                  "  console.log('Registered user email:', jsonData.data.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"StrongPass1!\",\n  \"interests\": [\"Design\", \"Travel\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
